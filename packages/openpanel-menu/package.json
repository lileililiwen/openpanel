{
  "name": "openpanel-menu",
  "version": "0.1.0",
  "description": "Baota-style numbered-menu CLI for OpenPanel operators (opctl).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "opctl": "./dist/index.js",
    "openpanel-menu": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts/install.sh",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "start": "node ./dist/index.js",
    "dev": "tsx ./src/index.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
